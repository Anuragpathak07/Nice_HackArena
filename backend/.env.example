# Supabase PostgreSQL Configuration Example
# Replace with your own Supabase / PostgreSQL credentials
DATABASE_URL=postgresql://postgres.your-project-ref:YourPassword@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
